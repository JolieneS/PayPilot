{
  "name": "Invoice Assistant",
  "nodes": [
    {
      "parameters": {
        "text": "={{ $json.text }}",
        "attributes": {
          "attributes": [
            {
              "name": "vendor_name",
              "description": "Output ONLY valid, raw JSON. Do NOT wrap your response in ```json or any markdown. Do NOT include any explanations, thoughts, or inline comments (no //). Extract the official name of the billing company.\n",
              "required": true
            },
            {
              "name": "invoice_number",
              "description": "The unique invoice ID or bill number.",
              "required": true
            },
            {
              "name": "orignal_amount",
              "type": "number",
              "description": "The grand total amount on the invoice.",
              "required": true
            },
            {
              "name": "gst_amount",
              "type": "number",
              "description": "Look carefully for GST, CGST, SGST, or IGST line items. Output the total combined tax amount. If no tax is charged, output 0.\n",
              "required": true
            },
            {
              "name": "date",
              "description": "The billing or issue date of the invoice.",
              "required": true
            },
            {
              "name": "currency_code",
              "description": "Translate the currency symbol into its 3-letter ISO code. Output ONLY the 3-letter code. Do NOT add any explanations, assumptions, or comments next to the code.",
              "required": true
            },
            {
              "name": "fraud_flag",
              "type": "boolean",
              "description": "={{ $json.gst_amount > 0 && !$json.vendor_gstin ? true : false }}\n\n\n",
              "required": true
            },
            {
              "name": "fraud_reason",
              "description": "={{ $json.gst_amount > 0 && !$json.vendor_gstin ? \"Tax of ₹\" + $json.gst_amount + \" charged, but no valid GSTIN is present on the document.\" : \"\" }}\n\n"
            },
            {
              "name": "vendor_gstin",
              "description": "Extract the 15-character alphanumeric GST Number. If it is not explicitly printed on the invoice, you MUST output an empty string \"\". Do not output \"N/A\" or \"None\".\n"
            }
          ]
        },
        "options": {}
      },
